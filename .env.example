# ==============================================================================
# lnwjud Project Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# Never commit the resulting .env file.
# ==============================================================================

# WARNING: Unrestricted mode intentionally exposes every fixed local drive to
# lnwjud's workspace/capability boundary. Destructive operations are still
# centrally gated, but this is a high-trust local-agent configuration.
LNWJUD_UNRESTRICTED=1

# Storage & Data Paths
# LNWJUD_DATA_PATH=C:\Users\YourUser\AppData\Roaming\lnwjud

# Optional: start/select a specific workspace on desktop startup.
# LNWJUD_WORKSPACE=D:\projects\my-app

# Optional: semicolon-separated extra capability roots.
# LNWJUD_CAPABILITY_ROOTS=D:\projects;E:\work

# Optional advanced override for the official OpenAI Secure MCP Tunnel client.
# Installed/portable desktop releases use their bundled tunnel-client automatically.
# LNWJUD_TUNNEL_CLIENT_PATH=D:\Tools\tunnel-client.exe

# Optional: path to installed lnwjud desktop executable.
# LNWJUD_PATH=C:\Users\YourUser\AppData\Local\Programs\lnwjud\lnwjud.exe

# Desktop loopback Streamable HTTP MCP port.
# Default: automatic (0), so the OS chooses a free loopback port without user setup.
# Set a non-zero value only when you intentionally want to pin a fixed port.
# LNWJUD_MCP_PORT=18765

# Optional extra Host header allow-list for a trusted local reverse proxy/tunnel.
# Hostnames only, separated by semicolons; localhost/127.0.0.1/[::1] remain allowed by default.
# LNWJUD_MCP_ALLOWED_HOSTNAMES=example.ngrok-free.dev

# Logging Level (debug, info, warn, error)
# LNWJUD_LOG_LEVEL=info

# Node Environment (development / production)
NODE_ENV=development
